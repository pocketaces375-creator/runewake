# Build outputs
bin/
obj/
export/
client/.godot/
android/
*.apk
*.idsig
*.zip

# IDE and temp files
*.user
*.tmp
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# Python
__pycache__/
*.pyc
.env
venv/
.venv/

# Screenshots (generated during testing)
screenshots/

# Capture artifacts (force-add individual files for commits).
# Written as a contents glob rather than a bare directory so the negation
# below can take effect — git will not re-include a file whose parent
# DIRECTORY is excluded, but will if the exclusion is on the entries.
artifacts/captures/*
# CAPTURE_STAMP.json must be committed: it is the record of which code
# rendered the captures, and it is worthless if it only exists on the
# machine that made it. See tools/capture_stamp.py.
!artifacts/captures/CAPTURE_STAMP.json

# Foreman logs (auto-generated)
tools/foreman_cron.log
tools/foreman_last_run.log

# Godot specific
client/.import/
client/export_presets.cfg

# Release keystore (must never be committed — lives outside repo at ~/.runewake/)
client/exports/release.keystore

# OS files
*.o
*.so
FOREMAN_HALT

# per-lane foreman logs (never tracked)
tools/foreman_lane*.log
tools/burn_guard.log

# Art working files (moved to ~/runewake_art_archive)
client/content/art/**/raw/
client/content/art/**/nano_*/
client/content/art/**/flux_*/

# FABLE-018: real Supabase config lives only on the build machine.
# client/supabase_config.example.json IS committed; the real one never is.
client/supabase_config.json
