  "biomes_doc": "menu: the features a page of this biome can show (duplicates allowed and likely); always: features every page has; keep: the guardian's feature on the east side.",
  "biomes": {
    "elvenwood":           { "menu": ["forest", "forest", "ancient_grove", "river", "mountain_range", "lake", "ruins", "plain"], "always": ["forest"], "keep": "stronghold" },
    "deepdelve":           { "menu": ["mountain_range", "mountain_range", "mine", "canyon", "ruins", "river", "volcano"],         "always": ["mountain_range"], "keep": "mine" },
    "saltglass":           { "menu": ["coast", "coast", "marsh", "plain", "ruins", "river", "lake"],                             "always": ["coast"], "keep": "stronghold" },
    "barrowmarch":         { "menu": ["marsh", "marsh", "ruins", "ruins", "forest", "river", "plain"],                           "always": ["marsh", "ruins"], "keep": "ruins" },
    "sunscar":             { "menu": ["dunes", "canyon", "plain", "ruins", "mountain_range", "river"],                           "always": ["dunes"], "keep": "stronghold" },
    "lost_forge":          { "menu": ["volcano", "mountain_range", "mine", "canyon", "ruins"],                                   "always": ["volcano"], "keep": "mine" },
    "moonwell":            { "menu": ["ancient_grove", "forest", "lake", "lake", "river", "ruins"],                              "always": ["ancient_grove", "lake"], "keep": "ancient_grove" },
    "drowned_observatory": { "menu": ["coast", "observatory", "marsh", "ruins", "lake"],                                         "always": ["observatory", "coast"], "keep": "observatory" }
