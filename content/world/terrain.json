{
  "//": "FABLE-105 - THE TERRAIN RULES. One vocabulary shared by three things that must agree: (1) the prompt a map painting is generated from, (2) where the game puts its places on that painting, (3) what those places are called. See docs/WORLD_TERRAIN.md. Engine: engine/World/Terrain.cs. Tools: tools/world_map_paint.py, tools/gen_start_zones.py, tools/style_lora.py (captions use these words).",
  "grid_doc": "Every plan speaks in a 3x3 grid so the painter and the game mean the same spot. Canvas is 1000 x 600 (world pages) or the plate's own pixels (campaign maps).",
  "grid": {
    "cells": ["north-west", "north", "north-east", "west", "centre", "east", "south-west", "south", "south-east"]
  },
  "painter": {
    "trigger": "runewake map",
    "style": "top-down painted fantasy atlas map, aged parchment tones, hand-painted relief, soft golden light from the upper right, no text, no labels, no compass rose, no borders, no legend",
    "roads": "a faint dotted road enters from the west edge and winds east across the land, ending at the stronghold on the east side",
    "negative": "text, letters, labels, watermark, compass, legend, border frame, photo, 3d render, grid lines"
  },
  "features": {
    "mountain_range": {
      "paint": "a jagged mountain range of grey rock and snow-touched peaks",
      "cells_wide": 2,
      "spots": [
        { "kind": "pass",     "nouns": ["Pass", "Gap", "Saddle", "Notch", "Gate"],            "fits": ["Warden", "AreaBoss", "Elite", "Duel"] },
