<Project Sdk="Godot.NET.Sdk/4.3.0">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <!-- CS8602/CS8618: Godot pattern — nodes set via GetNode() in _Ready(), not in constructor -->
    <NoWarn>$(NoWarn);CS8602;CS8618</NoWarn>
    <RootNamespace>Runewake.Client</RootNamespace>
    <ImplicitUsings>true</ImplicitUsings>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\engine\Runewake.Engine.csproj" />
    <ProjectReference Include="..\persistence\Runewake.Persistence.csproj" />
    <ProjectReference Include="..\sim\Runewake.Sim.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.10" />
  </ItemGroup>
</Project>
